    <path
        android:fillColor="#0F1419"
        android:pathData="M0,0h108v108h-108z" />
    <group
        android:translateX="24"
        android:translateY="24">
        <!-- Blue tile -->
        <path
            android:fillColor="#6C8EBF"
            android:pathData="M0,0h60v60h-60z" />
        <!-- Document page -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M8,8l34,0l0,44l-34,0z" />
        <path
            android:fillColor="#B9C2CC"
            android:pathData="M8,16l34,0l0,2l-34,0z" />
        <path
            android:fillColor="#B9C2CC"
            android:pathData="M12,24l26,0l0,2l-26,0z" />
        <path
            android:fillColor="#B9C2CC"
            android:pathData="M12,30l26,0l0,2l-26,0z" />
        <path
            android:fillColor="#B9C2CC"
            android:pathData="M12,36l20,0l0,2l-20,0z" />
        <!-- Pen -->
        <path
            android:fillColor="#4A6A95"
            android:pathData="M44,10l4,-4l8,8l-4,4z" />
        <path
            android:fillColor="#4A6A95"
